#!/usr/bin/env python3
"""jev-browse command-line launcher: runs `python3 -m jev_browse` from this checkout, from any directory.
Symlink it onto your PATH: ln -s "$PWD/bin/jev-browse" ~/.local/bin/jev-browse"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from jev_browse.__main__ import main  # noqa: E402

sys.exit(main())
